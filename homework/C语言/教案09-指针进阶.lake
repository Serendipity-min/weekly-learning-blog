22sizeof(arr)%3A%25ld%5C%5Cn%5C%22%2Csizeof(arr))%3B%20%2F%2Fsizeof(arr)%3A20%20%2F%2F%E6%B1%82%E6%95%B4%E4%B8%AA%E6%95%B0%E7%BB%84%E6%89%80%E5%8D%A0%E5%86%85%E5%AD%98%E5%A4%A7%E5%B0%8F%5Cn%5Cn%20%20%20%20%2F%2Fsizeof(arr%2B0)%3A8%20arr%E5%85%88%E4%B8%8E0%E7%BB%93%E5%90%88%EF%BC%8C%E8%A1%A8%E7%A4%BA%E6%95%B0%E7%BB%84%E9%A6%96%E5%85%83%E7%B4%A0%E5%81%8F%E7%A7%BB0%E4%B8%AA%E5%8D%95%E4%BD%8D%EF%BC%8C%E5%BE%97%E5%88%B0%E7%9A%84%E7%BB%93%E6%9E%9C%E4%BB%8D%E7%84%B6%E4%B8%BA%E4%B8%80%E4%B8%AA%E5%9C%B0%E5%9D%80%EF%BC%8C%5Cn%20%20%20%20%2F%2Fsizeof()%E5%AF%B9%E5%9C%B0%E5%9D%80%E6%B1%82%E5%80%BC%E7%9B%B8%E5%BD%93%E4%BA%8E%E5%AF%B9%E6%8C%87%E9%92%88%E5%8F%98%E9%87%8F%E6%B1%82%E5%80%BC%EF%BC%8C%E6%89%80%E4%BB%A5%E7%BB%93%E6%9E%9C%E4%B8%BA8%5Cn%20%20%20%20printf(%5C%22sizeof(arr%2B0)%3A%25ld%5C%5Cn%5C%22%2Csizeof(arr%2B0))%3B%20%5Cn%5Cn%20%20%20%20int%20a%3D100%3B%5Cn%20%20%20%20int%20*p%20%3D%26a%3B%5Cn%20%20%20%20printf(%5C%22%25ld%5C%5Cn%5C%22%2Csizeof(p))%3B%20%20%2F%2F8%5Cn%5Cn%7D%5Cn%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22gjwcS%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23%20include%20%3Cstdio.h%3E%5Cn%20%20%20%20int%20main(%20void)%5Cn%7B%5Cn%20%20%20%20int%20a%5B5%5D%3D%7B1%2C2%2C3%2C4%2C5%7D%3B%5Cn%20%20%20%20int%20*ptr%3D(%20int%20*)(%26a%2B1)%3B%5Cn%20%20%20%20printf(%5C%22%25d%2C%25d%5C%22%2C*(a%2B1)%2C*(ptr-1))%3B%5Cn%20%20%20%20return%200%3B%5Cn%20%20%20%20%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22iXS7t%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="u65aea753" id="u65aea753"><card type="inline" name="label" value="data:%7B%22label%22%3A%22%E6%95%B0%E7%BB%84%E4%B8%8E%E6%8C%87%E9%92%88%22%2C%22colorIndex%22%3A2%2C%22id%22%3A%22pc64c%22%7D" class="lake-fontsize-12"></card><span data-lake-id="ufb0d0c8b" id="ufb0d0c8b" class="lake-fontsize-12">：</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20a%5B3%5D%20%3D%20%7B1%2C2%2C3%7D%3B%5Cnint%20b%20%3D%20a%5B0%5D%3B%5Cn%5Cnint%20c1%20%3D%20*(a%2B0)%3B%20%2F%2F%20a%5B0%5D%5Cnint%20c2%20%3D%20*(a%2B1)%3B%20%2F%2F%20a%5B1%5D%5Cnint%20c3%20%3D%20*(a%2B2)%3B%20%2F%2F%20a%5B2%5D%5Cnprintf(%5C%222%5Ba%5D%20%3D%20%25d%5C%5Cn%5C%22%2C2%5Ba%5D)%3B%2F%2F%E7%89%B9%E6%AE%8A%E5%86%99%E6%B3%95%5Cn%2F%2F%20*%E7%9A%84%E4%BD%9C%E7%94%A8%E5%B0%B1%E6%98%AF%5B%5D%E7%9B%B8%E5%BD%93%E4%BA%8E%E8%A7%A3%E5%BC%95%E7%94%A8%5Cnprintf(%5C%22%25d%2C%25d%2C%25d%2C%25d%5C%5Cn%5C%22%2Ca%5B0%5D%2C*(a%2B0)%2C*(0%2Ba)%2C0%5Ba%5D)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22GrzuX%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="ud16d2204" id="ud16d2204"><span data-lake-id="u4a7b060c" id="u4a7b060c" class="lake-fontsize-12">指针转数组：</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20b%5B10%5D%3B%5Cn%5Cnint%20*a%20%3D%20b%3B%5Cna%5B0%5D%20%3D%201%3B%5Cnprintf(%5C%22%25d%5C%5Cn%5C%22%2Ca%5B0%5D)%3B%5Cn%5Cn%2F%2F%20%E5%A6%82%E6%9E%9C%E6%98%AF%E6%8C%87%E9%92%88%E6%93%8D%E4%BD%9C%EF%BC%8C%E4%BC%9A%E4%BF%AE%E6%94%B9%E5%8E%9F%E6%9C%89%E7%A9%BA%E9%97%B4%E7%9A%84%E5%86%85%E5%AE%B9%5Cn%2F%2F%20%E6%8C%87%E9%92%88%E4%B8%8E%E5%8E%9F%E7%A9%BA%E9%97%B4%E4%B8%BA%E5%90%8C%E4%B8%80%E5%9D%97%E7%A9%BA%E9%97%B4%5Cnint%20a%5B3%5D%20%3D%20%7B3%2C4%2C5%7D%3B%5Cnint%20*p%20%3D%20a%3B%5Cnp%5B1%5D%20%3D%2010%3B%5Cnprintf(%5C%22%25d%2C%25d%2C%25d%5C%5Cn%5C%22%2C*(p%2B1)%2Cp%5B1%5D%2Ca%5B1%5D)%3B%5Cn%5Cn%2F%2F%20%E7%A9%BA%E9%97%B4%E4%B8%8D%E5%B1%9E%E4%BA%8E%E5%90%8C%E4%B8%80%E5%9D%97%E7%A9%BA%E9%97%B4%5Cnint%20b%20%3D%2019%3B%5Cnint%20q%20%3D%20b%3B%5Cnq%20%3D%2018%3B%5Cnprintf(%5C%22%25d%2C%25d%5C%5Cn%5C%22%2Cb%2Cq)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22RdkaQ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="ue4d8849e" id="ue4d8849e"><card type="inline" name="label" value="data:%7B%22label%22%3A%22%E7%BB%83%E4%B9%A0%22%2C%22colorIndex%22%3A2%2C%22id%22%3A%22FgHnH%22%7D" class="lake-fontsize-12"></card><span data-lake-id="u14ca71ae" id="u14ca71ae" class="lake-fontsize-12">：</span></p><p data-lake-id="u1af0aa83" id="u1af0aa83"><span data-lake-id="u3a52e752" id="u3a52e752" class="lake-fontsize-12">int array[5] = {10,20,30,40,50};</span></p><p data-lake-id="udab2f7a3" id="udab2f7a3"><span data-lake-id="ufdb6d818" id="ufdb6d818" class="lake-fontsize-12">要求定义一个指针p存储数组的名字，通过数组名或者指针将所有获取到40数据的方法罗列出来</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Lwbk6%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="uc4f53001" id="uc4f53001"><span data-lake-id="u708072c6" id="u708072c6" class="lake-fontsize-12">注意：</span></p><ul list="u94fc5701" class="lake-list"><li fid="u8ed28f93" version="1735739826162" data-lake-id="u5dd2d66d" id="u5dd2d66d" class="lake-list-node lake-list-task"><card type="inline" name="checkbox" value="data:true"></card><span data-lake-id="u66c04ffe" id="u66c04ffe" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">指针一定要指向一块合法的空间，否则出现段错误，没有空间自行分配</span></li></ul><p data-lake-id="ud674b1d9" id="ud674b1d9"><card type="inline" name="label" value="data:%7B%22label%22%3A%22%E7%BB%83%E4%B9%A02%22%2C%22colorIndex%22%3A2%2C%22id%22%3A%22NMWSX%22%7D" class="lake-fontsize-12"></card><span data-lake-id="u5c89bfad" id="u5c89bfad" class="lake-fontsize-12">：</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22char%20b%5B5%5D%20%3D%20%7B'a'%2C'b'%2C'c'%2C'd'%2C'e'%7D%3B%5Cnint%20*q%20%3D%20(int%20*)%26b%5B0%5D%3B%5Cnprintf(%5C%22%25c%5C%5Cn%5C%22%2C*(q%2B1))%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22dEtvW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><h1 data-lake-id="d9v7x" id="d9v7x"><span data-lake-id="u9ebf8665" id="u9ebf8665">2.数组型实际参数(第10章讲解)</span></h1><p data-lake-id="4118377c97a410a0e26d2cbb9fb02510" id="4118377c97a410a0e26d2cbb9fb02510"><span data-lake-id="ub8f46c3e" id="ub8f46c3e" class="lake-fontsize-12">数组名在传递给函数时，总是被视为指针。</span></p><p data-lake-id="f137f0f35353ca81302ff767d8a5a5f5" id="f137f0f35353ca81302ff767d8a5a5f5"><span data-lake-id="ufb2c0dd8" id="ufb2c0dd8" class="lake-fontsize-12">​</span><br></p><h1 data-lake-id="MnZEv" id="MnZEv"><span data-lake-id="u1341e563" id="u1341e563">3.char型指针</span></h1><p data-lake-id="973c8d9281f97a6e0b7287f3c65eec6c" id="973c8d9281f97a6e0b7287f3c65eec6c"><span data-lake-id="u32680c7b" id="u32680c7b" class="lake-fontsize-12">char型指针实质上跟别的类型的指针并无本质区别，但由于C语言中的字符串以字符数组的方式存储，而数组在大多数场合又会表现为指针，因此字符串在绝大多数场合就表现为char型指针。</span><span data-lake-id="u8f7a1ebb" id="u8f7a1ebb" class="lake-fontsize-12">但是字符数组和字符指针在存储空间上有本质的区别，这个我们在内存管理章节里会详细说明。</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22char%20a%5B10%5D%3D%5C%22abcd%5C%22%3B%5Cnchar%20*p%20%3D%20%5C%22abcd%5C%22%3B%20%5Cn%2F%2F%E6%98%AF%E6%8A%8A%5C%22abcd%5C%22%E8%BF%99%E4%B8%AA%E5%AD%97%E7%AC%A6%E4%B8%B2%E6%94%BE%E5%85%A5%E6%8C%87%E9%92%88%E5%8F%98%E9%87%8Fp%5Cn%2F%2F%E6%98%AF%E6%8A%8A%5C%22abcd%5C%22%E8%BF%99%E4%B8%AA%E5%AD%97%E7%AC%A6%E4%B8%B2%E9%A6%96%E5%85%83%E7%B4%A0%E7%9A%84%E7%A9%BA%E9%97%B4%E5%86%85%E5%AD%98%E5%9C%B0%E5%9D%80%E7%BB%99p%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22sAHKc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="5e5323eef947947af6fa5e51eaa268a3" id="5e5323eef947947af6fa5e51eaa268a3"><span data-lake-id="u47f5b5be" id="u47f5b5be" class="lake-fontsize-12">​</span><br></p><h1 data-lake-id="xkesi" id="xkesi"><span data-lake-id="u68b75e1b" id="u68b75e1b">4.void型指针</span></h1><p data-lake-id="7892488cac2f2a69bdfb3950ecff1d63" id="7892488cac2f2a69bdfb3950ecff1d63"><span data-lake-id="ub88ebe43" id="ub88ebe43" class="lake-fontsize-12">无法明确指针所指向的数据类型时，可以将指针定义为 void 型指针</span></p><ul list="u05855b07"><li fid="ue97af212" data-lake-id="ucb37e611" id="ucb37e611"><span data-lake-id="ud1a5a4ff" id="ud1a5a4ff" class="lake-fontsize-12">void 型指针无法直接索引目标，必须将其转换为一种具体类型的指针方可索引目标</span></li><li fid="ue97af212" data-lake-id="ua32b63ff" id="ua32b63ff"><span data-lake-id="udd163f8e" id="udd163f8e" class="lake-fontsize-12">void 型指针无法进行加减法运算</span></li></ul><p data-lake-id="cf90b2c874c9e681399ac0f58f9dfa13" id="cf90b2c874c9e681399ac0f58f9dfa13"><span data-lake-id="u29a404d8" id="u29a404d8" class="lake-fontsize-12">void关键字的三个作用：</span></p><ul list="u721dda75"><li fid="uef26f45b" data-lake-id="u694f3eca" id="u694f3eca"><span data-lake-id="uc8bade8c" id="uc8bade8c" class="lake-fontsize-12">修饰指针，表示指针指向一个类型未知的数据。</span></li><li fid="uef26f45b" data-lake-id="u9b0ddd77" id="u9b0ddd77"><span data-lake-id="u79b697ef" id="u79b697ef" class="lake-fontsize-12">修饰函数参数列表，表示函数不接收任何参数。（函数章节）</span></li><li fid="uef26f45b" data-lake-id="u74e57129" id="u74e57129"><span data-lake-id="u26061b31" id="u26061b31" class="lake-fontsize-12">修饰函数返回类型，表示函数不会返回任何数据。（函数章节）</span></li></ul><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%2F%2F%E6%8C%87%E9%92%88%20p%20%E6%8C%87%E5%90%91%E4%B8%80%E5%9D%97%204%20%E5%AD%97%E8%8A%82%E7%9A%84%E5%86%85%E5%AD%98%EF%BC%8C%E4%B8%94%E8%BF%994%E5%AD%97%E8%8A%82%E6%95%B0%E6%8D%AE%E7%B1%BB%E5%9E%8B%E6%9C%AA%E7%A1%AE%E5%AE%9A%5Cnvoid%20*p%20%3D%20malloc(4)%3B%5Cn%5Cn%2F%2F%201%EF%BC%8C%E5%B0%86%E8%BF%99%204%20%E5%AD%97%E8%8A%82%E5%86%85%E5%AD%98%E7%94%A8%E6%9D%A5%E5%AD%98%E5%82%A8%20int%20%E5%9E%8B%E6%95%B0%E6%8D%AE%5Cn*(int%20*)p%20%3D%20100%3B%5Cnprintf(%5C%22%25d%5C%5Cn%5C%22%2C%20*(int%20*)p)%3B%5Cn%5Cn%5Cnint%20data%20%3D%2010%3B%5Cn%2F%2F%20%E5%AE%9A%E4%B9%89%E9%80%9A%E7%94%A8%E7%B1%BB%E5%9E%8B%E6%8C%87%E9%92%88p%E6%8C%87%E5%90%91data%E7%9A%84%E5%9C%B0%E5%9D%80%EF%BC%8C%E4%BD%86%E6%98%AFp%E7%9A%84%E7%B1%BB%E5%9E%8B%E4%B8%8D%E7%A1%AE%E5%AE%9A%5Cnvoid%20*p1%20%3D%20%26data%3B%5Cn%2F%2F%20%E8%BE%93%E5%87%BA%E7%9A%84%E6%97%B6%E5%80%99%E8%A6%81%E7%A1%AE%E5%AE%9Ap%E7%9A%84%E7%B1%BB%E5%9E%8B%EF%BC%8C%E6%89%80%E4%BB%A5%E9%9C%80%E8%A6%81%E5%BC%BA%E5%88%B6%E7%B1%BB%E5%9E%8B%E8%BD%AC%E6%8D%A2%EF%BC%8C%E5%90%A6%E5%88%99%E6%8A%A5%E9%94%99%5Cnprintf(%5C%22%25d%5C%5Cn%5C%22%2C*(int%20*)p)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Z3wpy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="u63ab78a8" id="u63ab78a8"><br></p><p data-lake-id="bba30955ee9e5fcbc02e505617c731ee" id="bba30955ee9e5fcbc02e505617c731ee"><span data-lake-id="ubb2173d1" id="ubb2173d1" class="lake-fontsize-12">注意：以上示例仅仅是为了讲解 void 的语法，实际应用中一般不需要定义 void 型指针，而是根据具体的需要，直接定义具体类型的指针，自主申请的内存除外。</span></p><p data-lake-id="310dc83d4186ec2aa56798c257398f72" id="310dc83d4186ec2aa56798c257398f72"><span data-lake-id="uaa5cdf45" id="uaa5cdf45" class="lake-fontsize-12">​</span><br></p><h1 data-lake-id="O5RbZ" id="O5RbZ"><span data-lake-id="u166146d4" id="u166146d4">5.const型指针</span></h1><p data-lake-id="a5680f49a26d57e2a639217ad5c7a6af" id="a5680f49a26d57e2a639217ad5c7a6af"><span data-lake-id="u94b9c4e8" id="u94b9c4e8" class="lake-fontsize-12">const是一个C语言的关键字，它限定一个变量不允许被改变,产生静态作用，也就是说经过const 修饰的变量成为只读的变量之后，那么这个变量就只能作为右值(只能赋值给别人)，绝对不能成为左值(不能接收别人的赋值)</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%2F%2F%E7%BB%8F%E8%BF%87const%20%E4%BF%AE%E9%A5%B0%E7%9A%84%E5%8F%98%E9%87%8F%EF%BC%8C%E5%9C%A8%E5%AE%9A%E4%B9%89%E7%9A%84%E6%97%B6%E5%80%99%EF%BC%8C%E5%B0%B1%E8%A6%81%E8%BF%9B%E8%A1%8C%E5%88%9D%E5%A7%8B%E5%8C%96%5Cn%5Cnconst%20int%20a%20%3D%2010%3B%20%20%2F%2F%20%E6%AD%A3%E7%A1%AE%5Cnconst%20int%20a%3B%20%20%2F%2F%20%E9%94%99%E8%AF%AF%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22tqVxj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="c23fcd066ed0cbf11ae280cdd6729a7a" id="c23fcd066ed0cbf11ae280cdd6729a7a"><span data-lake-id="u04b69bbe" id="u04b69bbe" class="lake-fontsize-12">const型指针有两种形式：①常指针 ②常目标指针</span></p><p data-lake-id="eb6175dd01619459fef534bebf129029" id="eb6175dd01619459fef534bebf129029"><span data-lake-id="uea85b6ee" id="uea85b6ee" class="lake-fontsize-12">1.常指针：const修饰指针本身，表示指针变量本身无法修改。</span></p><p data-lake-id="39011e3304fa1b77cb8cb85fba445c58" id="39011e3304fa1b77cb8cb85fba445c58" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F46168485%2F1735560128709-139b1557-9414-47ea-a6d3-488f2d1442b8.png%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A568%2C%22height%22%3A143%2C%22linkTarget%22%3A%22%22%2C%22originWidth%22%3A771%2C%22originHeight%22%3A194%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f8f5f5%22%2C%22id%22%3A%22CKGpE%22%7D" class="lake-fontsize-12"></card></p><p data-lake-id="eecb80fc86257904abedda1a3e70dfca" id="eecb80fc86257904abedda1a3e70dfca" style="text-align: center"><span data-lake-id="u16b52639" id="u16b52639" class="lake-fontsize-12">常指针：指针本身无法修改</span></p><p data-lake-id="b46c154f3f28dda13bcb3c9a023b6799" id="b46c154f3f28dda13bcb3c9a023b6799"><span data-lake-id="u5e1a2e01" id="u5e1a2e01" class="lake-fontsize-12">2.常目标指针：const修饰指针的目标，表示无法通过该指针修改其目标。 </span></p><p data-lake-id="9757382034e1538aa0e38e0251ec3953" id="9757382034e1538aa0e38e0251ec3953" style="text-align: center"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F46168485%2F1735560128937-115553d7-fb3f-4458-9697-c91dabf71baa.png%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A399%2C%22height%22%3A130%2C%22linkTarget%22%3A%22%22%2C%22originWidth%22%3A532%2C%22originHeight%22%3A173%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f8f4f4%22%2C%22id%22%3A%22wHnf3%22%7D" class="lake-fontsize-12"></card></p><p data-lake-id="eb22a52304593ca58e8e40af80cd39d1" id="eb22a52304593ca58e8e40af80cd39d1" style="text-align: center"><span data-lake-id="u1bbc76a4" id="u1bbc76a4" class="lake-fontsize-12">常目标指针：无法通过指针修改其目标</span></p><p data-lake-id="cecd1268888e94ffd5270680291d5fb3" id="cecd1268888e94ffd5270680291d5fb3"><span data-lake-id="u1829d613" id="u1829d613" class="lake-fontsize-12">常指针在实际应用中不常见。</span></p><p data-lake-id="87b888e589754f98fde10db0bb6a2abd" id="87b888e589754f98fde10db0bb6a2abd"><span data-lake-id="u22473b6d" id="u22473b6d" class="lake-fontsize-12">常目标指针在实际应用中广泛可见，用来限制指针的读写权限</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20a%20%3D%20100%3B%5Cnint%20b%20%3D%20200%3B%5Cn%5Cn%2F%2F%20%E7%AC%AC1%E4%B8%AD%E5%BD%A2%E5%BC%8F%EF%BC%8Cconst%E4%BF%AE%E9%A5%B0p1%E6%9C%AC%E8%BA%AB%EF%BC%8C%E5%AF%BC%E8%87%B4p1%E6%9C%AC%E8%BA%AB%E6%97%A0%E6%B3%95%E4%BF%AE%E6%94%B9%5Cnint%20*%20const%20p1%20%3D%20%26a%3B%20%5Cn%5Cn%2F%2F%20%E7%AC%AC2%E4%B8%AD%E5%BD%A2%E5%BC%8F%EF%BC%8Cconst%E4%BF%AE%E9%A5%B0p2%E7%9A%84%E7%9B%AE%E6%A0%87%EF%BC%8C%E5%AF%BC%E8%87%B4%E6%97%A0%E6%B3%95%E9%80%9A%E8%BF%87p2%E4%BF%AE%E6%94%B9a%5Cnint%20const%20*p2%20%3D%20%26a%3B%5Cnconst%20int%20*p2%20%3D%20%26a%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Oe8Oi%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><h1 data-lake-id="p4OLT" id="p4OLT"><span data-lake-id="u9f113281" id="u9f113281">6.多级指针</span></h1><p data-lake-id="3ecda720ca9a20b06af5131525f640c9" id="3ecda720ca9a20b06af5131525f640c9"><span data-lake-id="uc340f695" id="uc340f695" class="lake-fontsize-12">不管是二级指针还是多级指针，考虑它们和一级指针都是一样的，一级指针保存的是普通变量的地址，而二级（多级）指针保存的是指针变量的地址，即地址的地址</span></p><ul list="ua80626ad"><li fid="uc476522a" data-lake-id="u0ec6ba2b" id="u0ec6ba2b"><span data-lake-id="u5975717e" id="u5975717e" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">如果一个指针变量p1存储的地址，是另一个普通变量a的地址，那么称p1为一级指针</span></li><li fid="uc476522a" data-lake-id="ua2e60276" id="ua2e60276"><span data-lake-id="ub1d49d54" id="ub1d49d54" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">如果一个指针变量p2存储的地址，是指针变量p1的地址，那么称p2为二级指针</span></li></ul><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%3Cstdio.h%3E%5Cn%5Cnint%20main()%5Cn%7B%5Cnint%20data%20%3D%20100%3B%5Cnint%20*p%20%3D%20%26data%3B%5Cn%5Cnprintf(%5C%22data%E7%9A%84%E5%9C%B0%E5%9D%80%E6%98%AF%25p%5C%5Cn%5C%22%2C%26data)%3B%5Cnprintf(%5C%22p%E4%BF%9D%E5%AD%98data%E7%9A%84%E5%9C%B0%E5%9D%80%E6%98%AF%25p%EF%BC%8C%E5%86%85%E5%AE%B9%E6%98%AF%25d%5C%5Cn%5C%22%2Cp%2C*p)%3B%5Cn%5Cnint%20**p2%3B%5Cnp2%20%3D%20%26p%3B%5Cnprintf(%5C%22p2%E4%BF%9D%E5%AD%98%E7%9A%84%E6%98%AFp%E7%9A%84%E5%9C%B0%E5%9D%80%EF%BC%9A%25p%5C%5Cn%5C%22%2Cp2)%3B%5Cnprintf(%5C%22*p2%E6%98%AF%25p%5C%5Cn%5C%22%2C*p2)%3B%5Cnprintf(%5C%22**p2%E6%9D%A5%E8%AE%BF%E9%97%AEdata%EF%BC%9A%25d%5C%5Cn%5C%22%2C**p2)%3B%5Cn%5Cnreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Ee5Vu%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><h1 data-lake-id="T6cSZ" id="T6cSZ"><span data-lake-id="u8eeeac08" id="u8eeeac08">7.二维数组与指针</span></h1><p data-lake-id="92f5b265e76384069a11a9a01a919f92" id="92f5b265e76384069a11a9a01a919f92"><span data-lake-id="u54c06b16" id="u54c06b16" class="lake-fontsize-12">某些时候在描述二维数组是称之为二维，有行和列，但在内存中所有的数组元素都是连续排列的，它们之间没有“缝隙”。</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20a%5B3%5D%5B4%5D%20%3D%20%7B%20%7B0%2C%201%2C%202%2C%203%7D%2C%20%7B4%2C%205%2C%206%2C%207%7D%2C%20%7B8%2C%209%2C%2010%2C%2011%7D%20%7D%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OOGrF%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="8849a7a795218bcc57c5ce150294fa8c" id="8849a7a795218bcc57c5ce150294fa8c"><span data-lake-id="ubfa6e363" id="ubfa6e363" class="lake-fontsize-12">在内存中，a 的分布是一维线性的，整个数组占用一块连续的内存：</span></p><p data-lake-id="57279142efbe7e4b9f3dbc2b83165b79" id="57279142efbe7e4b9f3dbc2b83165b79"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F46168485%2F1735560129170-51d820bc-2364-47e7-a20c-4a8c20ddc0ba.png%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22%22%2C%22originWidth%22%3A436%2C%22originHeight%22%3A48%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23e8e8e8%22%2C%22id%22%3A%22cZvaA%22%7D" class="lake-fontsize-12"></card></p><p data-lake-id="a03e4f58e5572b4ad79d5d4a736a3fff" id="a03e4f58e5572b4ad79d5d4a736a3fff"><span data-lake-id="u704c3f21" id="u704c3f21" class="lake-fontsize-12">C语言允许把一个二维数组分解成多个一维数组来处理。对于数组 a，它可以分解成三个一维数组，即 a[0]、a[1]、a[2]。每一个一维数组又包含了 4 个元素，例如 a[0] 包含 a[0][0]、a[0][1]、a[0][2]、a[0][3]。</span></p><p data-lake-id="7427e93e436bd8f43e7f80ddf57086c3" id="7427e93e436bd8f43e7f80ddf57086c3"><span data-lake-id="u3c375c2e" id="u3c375c2e" class="lake-fontsize-12">假设数组 a 中第 0 个元素的地址为 1000，那么每个一维数组的首地址如下图所示：</span></p><p data-lake-id="9d8911e27c0a7d338aaff1014119e2ab" id="9d8911e27c0a7d338aaff1014119e2ab"><card type="inline" name="image" value="data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F46168485%2F1735560129329-2cdc882e-3561-4b7a-a6d3-75fbbcd5347f.png%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A510%2C%22height%22%3A195%2C%22linkTarget%22%3A%22%22%2C%22originWidth%22%3A414%2C%22originHeight%22%3A158%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23e6e6e6%22%2C%22id%22%3A%22BZuUR%22%7D" class="lake-fontsize-12"></card></p><p data-lake-id="7df93d3b5294769814e3c80dc33b6e21" id="7df93d3b5294769814e3c80dc33b6e21"><span data-lake-id="u64eaefee" id="u64eaefee" class="lake-fontsize-12">定义一个指向 a 的指针变量 p:</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20(*p)%5B4%5D%20%3D%20a%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22X5PG8%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="4113d371db9392546e6befb9c2c3577d" id="4113d371db9392546e6befb9c2c3577d" style="text-indent: 2em"><span data-lake-id="u71b6bed6" id="u71b6bed6" class="lake-fontsize-12">括号中的*表明 p 是一个指针，它指向一个数组，数组的类型为int [4]，这正是 a 所包含的每个一维数组的类型。[ ]的优先级高于*，( )是必须要加的，如果赤裸裸地写作int *p[4]，那么应该理解为int *(p[4])，p 就成了一个</span><u><span data-lake-id="ued962575" id="ued962575" class="lake-fontsize-12">指针数组</span></u><span data-lake-id="u37723541" id="u37723541" class="lake-fontsize-12">，而不是二维数组指针</span></p><p data-lake-id="3157eabc679454d0b0fd1400750a4925" id="3157eabc679454d0b0fd1400750a4925" style="text-indent: 2em"><span data-lake-id="u387b2cca" id="u387b2cca" class="lake-fontsize-12">p 指向的数据类型是int [4]，那么p+1就前进 4×4 = 16 个字节，p-1就后退 16 个字节，这正好是数组 a 所包含的每个一维数组的长度。也就是说，p+1会使得指针指向二维数组的下一行，p-1会使得指针指向数组的上一行。</span></p><p data-lake-id="ubc2154b5" id="ubc2154b5" style="text-indent: 2em"><span data-lake-id="uf421956a" id="uf421956a" class="lake-fontsize-12">​</span><br></p><p data-lake-id="6efe5aaaac2e67339099278aca5d3704" id="6efe5aaaac2e67339099278aca5d3704"><span data-lake-id="ue1605303" id="ue1605303" class="lake-fontsize-12">问下列表示什么意思?</span></p><ul list="u41732e7f"><li fid="ud1567cef" data-lake-id="ub1be8e0f" id="ub1be8e0f"><span data-lake-id="u8eb82f3b" id="u8eb82f3b" class="lake-fontsize-12">p+1 ：p+1 是对指针变量p前进一个单位，结果还是指向一个地址；在这里表示指向下一行数组的地址。</span></li><li fid="ud1567cef" data-lake-id="u6237286d" id="u6237286d"><span data-lake-id="uc7563d29" id="uc7563d29" class="lake-fontsize-12">*(p+1) ：*(p+1)表示第二行所有数据，在数值上和第二行首元素地址值相等。</span></li><li fid="ud1567cef" data-lake-id="ub1b1f72f" id="ub1b1f72f"><span data-lake-id="uad503865" id="uad503865" class="lake-fontsize-12">*(p+1)+1  ： 表示第二行第二个数据元素的地址 ，a[1][1]的地址</span></li><li fid="ud1567cef" data-lake-id="u567ba818" id="u567ba818"><span data-lake-id="uf3065bd4" id="uf3065bd4" class="lake-fontsize-12">*(*(p+1)+1) ：表示第二行第二个数据元素的值，a[1][1]的值</span></li></ul><p data-lake-id="fcf1b77e97ce5f6519a4a8bb7135aab2" id="fcf1b77e97ce5f6519a4a8bb7135aab2"><span data-lake-id="u20a980f2" id="u20a980f2" class="lake-fontsize-12">使用指针遍历二维数组:</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cnint%20main()%7B%5Cn%20%20%20%20int%20a%5B3%5D%5B4%5D%3D%7B0%2C1%2C2%2C3%2C4%2C5%2C6%2C7%2C8%2C9%2C10%2C11%7D%3B%5Cn%20%20%20%20int(*p)%5B4%5D%3B%5Cn%20%20%20%20int%20i%2Cj%3B%5Cn%20%20%20%20p%3Da%3B%5Cn%20%20%20%20for(i%3D0%3B%20i%3C3%3B%20i%2B%2B)%7B%5Cn%20%20%20%20%20%20%20%20for(j%3D0%3B%20j%3C4%3B%20j%2B%2B)%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20printf(%5C%22%25d%20%20%5C%22%2C*(*(p%2Bi)%2Bj))%3B%5Cn%20%20%20%20%20%20%20%20printf(%5C%22%5C%5Cn%5C%22)%3B%5Cn%20%20%20%20%7D%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22DOlpf%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="af497706269455754bed39070497d2bf" id="af497706269455754bed39070497d2bf"><span data-lake-id="udf6e2f33" id="udf6e2f33" class="lake-fontsize-12">​</span><br></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20a%5B4%5D%5B5%5D%20%2C(*p)%5B5%5D%3B%5Cnp%3Da%3B%5Cn%2F%2F%E8%BE%93%E5%87%BA%2F%E5%BC%95%E7%94%A8%E6%95%B0%E7%BB%84%E5%85%83%E7%B4%A0%E7%9A%84%E5%80%BC%5Cnp%2B1%20%3F%5Cn*(p%2B2)%20%3F%5Cnp%5B0%5D%5B1%5D%20%20%3F%5Cn*(p%2B1)%2B2%20%20%3F%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22nfqXT%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="u936fe120" id="u936fe120"><br></p><h1 data-lake-id="RiyyW" id="RiyyW"><span data-lake-id="u725099ea" id="u725099ea">8.问与答</span></h1><ol list="u34c1f7c7"><li fid="uf6a6b60d" data-lake-id="uc20090e7" id="uc20090e7"><span data-lake-id="ueda70f4e" id="ueda70f4e" class="lake-fontsize-12">我不理解指针的算术运算。如果指针是地址，那么这是否意味 着诸如p + j 这样的表达式是把j 加到存储在p 中的地址上呢？</span></li></ol><ul list="uc8d9e6b4"><li fid="u5b3fe81b" data-lake-id="u37506303" id="u37506303"><span data-lake-id="uba3316ce" id="uba3316ce" class="lake-fontsize-12">不是的。用于指针算术运算的整数需要根据指针的类型进行缩 放。例如，如果p 的类型是int * ，那么p + j 通常给p 加上4 ×  j （假定int 类型的值要用4个字节存储）。但是，如果p 的类型为 double * ，那么p + j 可能给p加上8 × j ，因为double 类型 的值通常都是8个字节长。</span></li></ul><p data-lake-id="89999b98c879d5aff1bcf3e00671efa6" id="89999b98c879d5aff1bcf3e00671efa6"><span data-lake-id="ub332efd2" id="ub332efd2" class="lake-fontsize-12">​</span><br></p><ol list="u34c1f7c7" start="2"><li fid="uf6a6b60d" data-lake-id="u74427a3f" id="u74427a3f"><span data-lake-id="u3d40db4b" id="u3d40db4b" class="lake-fontsize-12">编写处理数组的循环时，数组取下标和指针算术运算哪种更好 一些呢？</span></li></ol><ul list="u835236f9"><li fid="u04d3e9fb" data-lake-id="u9308ef2a" id="u9308ef2a"><span data-lake-id="u3c13251d" id="u3c13251d" class="lake-fontsize-12">这个问题不容易回答，因为答案与所使用的机器和编译器有关。 对于早期机器上的C语言，指针算术运算能生成更快的程序。如 果在现在的机器上采用现在的编译器，数组取下标方法常常跟指针算 术运算差不多，而且有时甚至会更好。底线是：学习这两种方法，然 后采用对你正在编写的程序更自然的方法。</span></li></ul><p data-lake-id="ebb8b3b4bd7334bcd415a0aeecf96f4d" id="ebb8b3b4bd7334bcd415a0aeecf96f4d"><span data-lake-id="uc00c13e4" id="uc00c13e4" class="lake-fontsize-12">​</span><br></p><ol list="u34c1f7c7" start="3"><li fid="uf6a6b60d" data-lake-id="u2d2cafe1" id="u2d2cafe1"><span data-lake-id="u1c839f04" id="u1c839f04" class="lake-fontsize-12">我在某些地方看到i[a] 和a[i] 是一样的，这是真的吗？</span></li></ol><ul list="u180659df"><li fid="uf1b5c7f4" data-lake-id="u9da96023" id="u9da96023"><span data-lake-id="u4d54e241" id="u4d54e241" class="lake-fontsize-12">是的，这是真的，确实很奇怪。对于编译器而言i[a] 等同于* (i + a) ，也就是*(a + i) （像普通加法一样，指针加法也是可 交换的）。而*(a + i) 也就是a[i] 。但是请不要在程序中使用 i[a] ，除非你正计划参加下一届模糊C代码大赛。</span></li></ul><p data-lake-id="1f870d14d85cba8532057622e7dcadf5" id="1f870d14d85cba8532057622e7dcadf5"><span data-lake-id="u2981cbf9" id="u2981cbf9" class="lake-fontsize-12">​</span><br></p><ol list="u34c1f7c7" start="4"><li fid="uf6a6b60d" data-lake-id="uc3b06fb7" id="uc3b06fb7"><span data-lake-id="u970f8f83" id="u970f8f83" class="lake-fontsize-12">我们已经看到C语言中数组和指针之间的紧密联系。称它们是可 互换的是否准确？</span></li></ol><ul list="u9234bc65"><li fid="uae0ab789" data-lake-id="uf486e8d9" id="uf486e8d9"><span data-lake-id="u8c1dadbf" id="u8c1dadbf" class="lake-fontsize-12">不准确，数 组型变量不同于指针变量，回顾上节课讲过的数组名的两种情形</span></li></ul><p data-lake-id="77a1070aad4aad6299333b6ce92d49ef" id="77a1070aad4aad6299333b6ce92d49ef"><span data-lake-id="u67dbe575" id="u67dbe575" class="lake-fontsize-12">​</span><br></p>
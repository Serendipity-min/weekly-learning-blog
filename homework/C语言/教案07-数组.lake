80%E7%BB%B4%EF%BC%8C*buf%E7%9B%B8%E5%BD%93%E4%BA%8E%E4%B8%80%E7%BB%B4%E6%95%B0%E7%BB%84%E7%9A%84%E6%95%B0%E7%BB%84%E5%90%8D%5Cnprintf(%5C%22%25c%2C%25c%2C%25c%2C%25c%5C%5Cn%5C%22%2Cbuf1%5B0%5D%5B1%5D%2C*(%26buf1%5B0%5D%5B1%5D)%2C*(buf1%5B0%5D%2B1)%2C*(*(buf1%2B0)%2B1))%3B%5Cnprintf(%5C%22%25c%2C%25c%2C%25c%2C%25c%5C%5Cn%5C%22%2Cbuf1%5B1%5D%5B2%5D%2C*(%26buf1%5B1%5D%5B2%5D)%2C*(buf1%5B1%5D%2B2)%2C*(*(buf1%2B1)%2B2))%3B%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22HRlHe%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="u30e419b8" id="u30e419b8"><card type="inline" name="label" value="data:%7B%22label%22%3A%22%E4%BA%8C%E7%BB%B4%E6%95%B0%E7%BB%84%E7%9A%84%E5%81%8F%E7%A7%BB%22%2C%22colorIndex%22%3A2%2C%22id%22%3A%22DBHKc%22%7D" class="lake-fontsize-12"></card><span data-lake-id="uf0a3c391" id="uf0a3c391" class="lake-fontsize-12">：</span></p><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22char%20buf%5B2%5D%5B4%5D%20%3D%20%7B%5C%22abc%5C%22%2C%5C%22efg%5C%22%7D%3B%5Cn%5Cn%20%20%20%20printf(%5C%22abc%20addr%3A%25p%5C%5Cn%5C%22%2Cbufa%5B0%5D)%3B%5Cn%20%20%20%20printf(%5C%22a%20addr%3A%25p%5C%5Cn%5C%22%2C%26bufa%5B0%5D%5B0%5D)%3B%5Cn%5Cn%20%20%20%20printf(%5C%22abc%20addr%2B1%3A%25p%5C%5Cn%5C%22%2Cbufa%5B0%5D%2B1)%3B%5Cn%20%20%20%20%20%2F%2Fprintf(%5C%22b%20addr%3A%25p%5C%5Cn%5C%22%2C%26bufa%5B0%5D%5B1%5D)%3B%5Cn%20%20%20%20printf(%5C%22%26abc%20addr%2B1%3A%25p%5C%5Cn%5C%22%2C%26bufa%5B0%5D%2B1)%3B%5Cn%5Cn%20%20%20%20printf(%5C%22efg%20addr%3A%25p%5C%5Cn%5C%22%2Cbufa%5B1%5D)%3B%5Cn%20%20%20%20printf(%5C%22e%20addr%3A%25p%5C%5Cn%5C%22%2C%26bufa%5B1%5D%5B0%5D)%3B%5Cn%5Cn%20%20%20%20printf(%5C%22buf%20addr%3A%25p%5C%5Cn%5C%22%2Cbufa)%3B%5Cn%20%20%20%20printf(%5C%22buf%2B1%20addr%3A%25p%5C%5Cn%5C%22%2Cbufa%2B1)%3B%5Cn%5Cn%20%20%20%20printf(%5C%22%26buf%20addr%3A%25p%5C%5Cn%5C%22%2C%26bufa)%3B%5Cn%20%20%20%20printf(%5C%22%26buf%2B1%20addr%3A%25p%5C%5Cn%5C%22%2C%26bufa%2B1)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ONCP7%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><p data-lake-id="u5f795ac9" id="u5f795ac9"><card type="inline" name="label" value="data:%7B%22label%22%3A%22%E6%80%BB%E7%BB%93%22%2C%22colorIndex%22%3A1%2C%22id%22%3A%22Bhmnu%22%7D" class="lake-fontsize-12"></card><span data-lake-id="udd09977d" id="udd09977d" class="lake-fontsize-12">：</span></p><ul list="uedad821c"><li fid="u6361544c" data-lake-id="u872ba796" id="u872ba796"><span data-lake-id="u521a3f69" id="u521a3f69" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">数组名有两个含义：</span><span data-lake-id="u1d2eaf43" id="u1d2eaf43" class="lake-fontsize-12" style="color: rgb(0, 0, 0); background-color: rgb(255, 255, 0)">​</span></li></ul><ul list="uedad821c" data-lake-indent="1"><li fid="ub5f5388d" data-lake-id="u2cb68233" id="u2cb68233"><span data-lake-id="ua4fbb244" id="ua4fbb244" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">第一含义是：整个数组</span></li><li fid="ub5f5388d" data-lake-id="ue68ac5b7" id="ue68ac5b7"><span data-lake-id="u863fc36d" id="u863fc36d" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">第二含义是：首元素地址</span></li></ul><ul list="uedad821c" start="2"><li fid="u6361544c" data-lake-id="u82b2e4b0" id="u82b2e4b0"><span data-lake-id="u0a3cd43c" id="u0a3cd43c" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">当出现以下情形时，那么数组名就代表整个数组：</span><span data-lake-id="ud941c5cb" id="ud941c5cb" class="lake-fontsize-12" style="color: rgb(0, 0, 0); background-color: rgb(255, 255, 0)">​</span></li></ul><ul list="uedad821c" data-lake-indent="1"><li fid="ua52cb336" data-lake-id="u997cc12c" id="u997cc12c"><span data-lake-id="uff72d06e" id="uff72d06e" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">在数组定义中</span></li><li fid="ua52cb336" data-lake-id="ufe2aa550" id="ufe2aa550"><span data-lake-id="u2a74cb11" id="u2a74cb11" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">在 sizeof 运算表达式中</span></li><li fid="ua52cb336" data-lake-id="u6bc4b07e" id="u6bc4b07e"><span data-lake-id="u08889917" id="u08889917" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">在取址符&amp;中</span></li></ul><ul list="uedad821c" start="3"><li fid="u6361544c" data-lake-id="u543e8e32" id="u543e8e32"><span data-lake-id="ue1aa9201" id="ue1aa9201" class="lake-fontsize-12" style="color: rgb(51, 51, 51)">其他任何情形下，那么数组名就代表首元素地址。即：此时数组名就是一个指向首元素的指针。</span></li></ul><card type="inline" name="codeblock" value="data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20a%5B3%5D%3B%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20%E6%AD%A4%E5%A4%84%EF%BC%8Ca%20%E4%BB%A3%E8%A1%A8%E6%95%B4%E4%B8%AA%E6%95%B0%E7%BB%84%5Cnprintf(%5C%22%25d%5C%5Cn%5C%22%2C%20sizeof(a))%3B%20%2F%2F%20%E6%AD%A4%E5%A4%84%EF%BC%8Ca%20%E4%BB%A3%E8%A1%A8%E6%95%B4%E4%B8%AA%E6%95%B0%E7%BB%84%5Cnprintf(%5C%22%25p%5C%5Cn%5C%22%2C%20%26a)%3B%20%20%2F%2F%20%E6%AD%A4%E5%A4%84%EF%BC%8Ca%20%E4%BB%A3%E8%A1%A8%E6%95%B4%E4%B8%AA%E6%95%B0%E7%BB%84%EF%BC%8C%E6%AD%A4%E5%A4%84%E4%B8%BA%E6%95%B4%E4%B8%AA%E6%95%B0%E7%BB%84%E7%9A%84%E5%9C%B0%E5%9D%80%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A16%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22h5BcP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D"></card><h1 data-lake-id="ntel8" id="ntel8"><span data-lake-id="u21637a29" id="u21637a29">5.问与答</span></h1><p data-lake-id="2b693c4193e28d40d5c8d38610f867b1" id="2b693c4193e28d40d5c8d38610f867b1"><span data-lake-id="u8abccdb0" id="u8abccdb0" class="lake-fontsize-12">我们平时计数，通常是从一开始计数的，为什么在编程语言中，数组的下标是从0开始计算的呢？</span></p><ul list="uc56b41e9"><li fid="u646879e2" data-lake-id="uecc7e707" id="uecc7e707"><span data-lake-id="u84e5b3d5" id="u84e5b3d5" class="lake-fontsize-12">这是因为，C语言中，下标的含意是：当前元素到第一个元素的偏移量。第一个元素的下标自然就是0，第二个元素的下标为1，第n个元素的下标为n-1。</span></li><li fid="u646879e2" data-lake-id="u96a70dd9" id="u96a70dd9"><span data-lake-id="uebc4f5bb" id="uebc4f5bb" class="lake-fontsize-12">让我用我最喜欢的例子来证明，基于0的索引甚至在技术世界之外也有好处:</span></li></ul><p data-lake-id="2a2c15278e2c23cf3a1737356b2c12d6" id="2a2c15278e2c23cf3a1737356b2c12d6"><span data-lake-id="u5481ee82" id="u5481ee82" class="lake-fontsize-12">2000年属于哪个世纪。通常的答案是:21世纪。这似乎是合乎逻辑的，但它是错误的，因为正式的年份编号从1开始，所以1世纪是1-100,2世纪是101-200，……20世纪是1901 - 2000。因为公元没有0年，一个世纪有100年，按照这个标准，2000年属于20世纪的最后一年。以0为基础的年份编号将使世纪边界更加符合逻辑(使用1900-1999而不是 1901-2000)。</span></p><p data-lake-id="66107b6f31f8639dd6dc29bc60ef2fa0" id="66107b6f31f8639dd6dc29bc60ef2fa0"><span data-lake-id="ubcc7b26d" id="ubcc7b26d" class="lake-fontsize-12">尺子(试着用从1开始的尺子来测量距离)</span></p><p data-lake-id="5c25ef714489e9140e22e762593b3be1" id="5c25ef714489e9140e22e762593b3be1"><span data-lake-id="u5ca74210" id="u5ca74210" class="lake-fontsize-12">时间(希望没有人愿意生活在午夜是01:01:01的世界里)</span></p><p data-lake-id="ucf7013ea" id="ucf7013ea"><br></p><p data-lake-id="2773f0283f409c7d020edcee8be35cef" id="2773f0283f409c7d020edcee8be35cef"><span data-lake-id="u5777fde2" id="u5777fde2" class="lake-fontsize-12">​</span><br></p><p data-lake-id="da4e0fb5f6c3d2039608fc5317951e34" id="da4e0fb5f6c3d2039608fc5317951e34"><br></p><p data-lake-id="27a8f5ed46fca81a83095324169eb492" id="27a8f5ed46fca81a83095324169eb492"><span data-lake-id="uac374874" id="uac374874" class="lake-fontsize-12">​</span><br></p><p data-lake-id="58d6cc20bc51617dfdc285e534094a30" id="58d6cc20bc51617dfdc285e534094a30"><span data-lake-id="ue23999ac" id="ue23999ac" class="lake-fontsize-12">​</span><br></p><p data-lake-id="9ca20eded30a3d061121cb13d0138b10" id="9ca20eded30a3d061121cb13d0138b10"><span data-lake-id="u68c1ac32" id="u68c1ac32" class="lake-fontsize-12">​</span><br></p>